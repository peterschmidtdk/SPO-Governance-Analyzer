# Output files — generated per run, not stored in repo
output/

# Local fix/session timelog — working notes, not stored in repo
timelog/

# Design mockup reference — local working file, not stored in repo
mockup/

# Claude Code local settings/permissions — machine-specific, not stored in repo
.claude/

# History data — local trend data, regenerated on each machine
history/

# Credentials — store in %USERPROFILE%\.spo-tools\config.json instead
# Only config.example.json is tracked; all other config files stay local
config/*
!config/config.example.json

# Logs
logs/
*.log

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
